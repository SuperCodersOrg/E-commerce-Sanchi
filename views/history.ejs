<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body class="history-page">
    <h1>My Orders</h1>
    <% if(orders.length === 0) { %>
        <div class="history-empty">
            <h2>You haven't placed any order yet..</h2>
            <a href="/all">Continue Shopping</a>
        </div>
    <% } %>
    <% orders.forEach((item)=>{ %>
        <div class="history-order">
            <h3>Order Id : <%= item._id %></h3>
            <p>Placed On: <%= new Date(item._id.getTimestamp()).toLocaleTimeString() %></p>
            <div>Payment Status: <%= item.paymentStatus %></div>
            <div>Payment Method: <%= item.paymentMethod %></div>
            <div>OrderStatus: <%= item.orderStatus %></div>
            <% item.items.forEach((order)=>{ %>
                <div>Product id: <%= order._id %></div>
                <div>Quantity: <%= order.quantity %></div>
                <div>Price: <%= order.price %></div>
            <% }) %>
            <h3>Total Amount: <%= item.totalAmount %></h3>
            <div class="history-address">
                <span class="address-label">Delivery Address:</span>
                <span><%= item.shippingAddress.fullName %></span>
                <span class="address-separator">|</span>
                <span>Phone: <%= item.shippingAddress.phone %></span>
                <span class="address-separator">|</span>
                <span>
                    <%= item.shippingAddress.address %>,
                    <%= item.shippingAddress.city %>,
                    <%= item.shippingAddress.state %> -
                    <%= item.shippingAddress.pincode %>
                </span>
            </div>
        </div>
        <hr>
    <% }) %>
</body>
</html>