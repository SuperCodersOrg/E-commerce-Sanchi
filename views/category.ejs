<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <header>
        <%- include('./partials/nameHeader') %>
        <%- include('./partials/header') %>
    </header>
    <div id="products">
    <%  products.forEach((item) => { %>
        <div class="product-card" data-id="<%= item._id %>">
            <img src="<%= item.image %>" alt="<% item.description %>"/>
            <h2><%= item.name %></h2>
            <a href="/prod/<%= item._id %>"><button>View details</button></a>
        </div>
    <% }) %> 
</div>
<button id="load_btn" type="button">Load more products...</button>
</body>
</html>