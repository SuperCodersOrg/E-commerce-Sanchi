<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <%- include('./partials/nameHeader') %>

    <div id="mid-cart">
        <h2>Your shopping bag</h2>
        <h3>Review your selections before checkout.</h3>
    </div>

    <div id="cartProducts">

        <% products.forEach((item)=>{ %>
            <div class="card" data-id="<%= item.userId %>">

                <div class="card-left">
                    <img src="<%= item.image %>" alt="<%= item.description %>"/>
                </div>

                <div class="card-right">
                    <h2 class="card-name">VELNORA . <%= item.category %></h2>
                    <div class="cart-title"><%= item.name %></div>
                    <div class="cart-price"><%= item.price %></div>
                    <div class="quantity-controls">
                        <span class="decrease"><button class="decrease_btn">-</button></span>
                        <span class="quantity"><%= item.quantity %></span>
                        <span class="increase"><button class="increase_btn">+</button></span>
                        <span class="removebtn">Remove</span>
                    </div>
                </div> 

            </div>
        <% }) %>
    </div>
    <a href="/address-page"><button id="place_order">Place order</button></a>
</body>
<script>
    let cartItems = document.getElementById("cartProducts");
    cartItems.addEventListener("click",async (event)=>{
        event.stopPropagation();
        event.preventDefault();

        if(event.target.closest('.removebtn')){
            let cartid = event.target.closest('.card').dataset.id;
            let product = event.target.closest('.card');

            const res = await fetch('/removeCart',{
                method : 'POST',
                headers : {
                    'Content-Type' : 'application/json'
                },
                body : JSON.stringify({ userId : cartid })
            })

            if(res.ok){
                product.remove();
            }else{
                alert('Unable to remove item');
            }
        }

        if(event.target.closest('.increase_btn')){
            let cartid = event.target.closest('.card').dataset.id;
            let card = event.target.closest('.card');

            const res = await fetch('/add-quantity',{
                method : 'POST',
                headers : {
                    'Content-Type' : 'application/json'
                },
                body : JSON.stringify({ userId : cartid })
            });

            if(res.ok){    
                const data = await res.json();
                card.querySelector('.quantity').textContent = data.quantity;
            }else{
                alert('Unable to add quantity');
            }

        }

        if(event.target.closest('.decrease_btn')){
            let cartid = event.target.closest('.card').dataset.id;
            let card = event.target.closest('.card');

            const res = await fetch('/dec-quantity',{
                method : 'POST',
                headers : {
                    'Content-Type' : 'application/json'
                },
                body : JSON.stringify({ userId : cartid })
            });

            if(res.ok){
                const data = await res.json();
                if(data.quantity === 0){
                    card.remove();
                    return;
                }else{
                    card.querySelector('.quantity').textContent = data.quantity;
                }
            }else{
                alert('Unable to add quantity');
            }

        }

    })

</script>
</html>