<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header>
        <div>
            <h3 id="website_name">VELNORA</h3>
            <div id="btns">
                <a href="/login"><span id="main_login_btn"><button>Login</button></a>
                <a href="/signin"><span id="main_signin_btn"><button>Signin</button></a> 
                <a href="/cart-page" id="cart_icon"> 🛒 Cart </a>
            </div>
        </div>
    </header>
    <div id="products">
        <%  Products.forEach((product,index) => { %>
            <div class="product-card" data-id="<%= product._id %>" data-name="<%= product.name %>" data-description="<%= product.description %>" data-price="<%= product.price %>" data-category="<%= product.category %>" data-image="<%= product.image %>">
                <img src="<%= product.image %>" alt="<% product.description %>"/>
                <h2><%= product.name %></h2>
                <button class="dash_cart" type="button">Add To Cart</button>
                <a href="/prod/<%= product._id %>"><button class="view">View details</button></a>
            </div>
        <% }) %> 
    </div>
</body>
<script>
    let cart_icon = document.getElementById("cart_icon");
    cart_icon.addEventListener("click",async ()=>{
        if(!isLoggedIn){
            event.preventDefault();
            await Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Signup to see your cart",
                footer: "Already have an account? <a href='/login'>Login</a>"
            });
        }
        else{
            syncCart();
        }
    });

    function getGuestCart(){
        return JSON.parse(localStorage.getItem('Product') || '[]');
    }

    function saveGuestCart(product){
        console.log('saved');
        localStorage.setItem('Product',JSON.stringify(product));
    }

    const isLoggedIn = <%- JSON.stringify(isLoggedin) %>;
    let productList = document.getElementById("products");
    productList.addEventListener("click",async (event)=>{
        if(event.target.closest('.dash_cart')){
            const button = event.target.closest('.dash_cart');
            const card_product = button.closest(".product-card");
            const product = {
                productId : card_product.dataset.id,
                name : card_product.dataset.name,
                description : card_product.dataset.description,
                image : card_product.dataset.image,
                category : card_product.dataset.category,
                price : Number(card_product.dataset.price),
                quantity : 1
            }

            const products = getGuestCart();
            console.log(products);
            const existing = products.find((item)=>{
                return item.productId === product.productId;
            })

            if(existing){
                existing.quantity += 1;
            }else{
                products.push(product);
            }

            saveGuestCart(products);
        }
    });

    async function syncCart(){
        try{    
            const carts = await getGuestCart();

            if(carts.length === 0){
                return res.send('Cart is empty');
            }

            const result = fetch('/sync-cart',{
                    method : 'POST',
                    headers : {
                     'Content-Type' : 'application/json'
                    },
                    body : JSON.stringify(carts)
            });

            const response = await result.josn();

            if(!response.ok){
                console.log(result.message);
                return res.send('Failed to fetch products');
            }else{
                localStorage.removeItem('Product');
                return res.send('Products added successfully');
            }
        }catch(error){
            return res.status(500).send('Internal server error');
        }
        
    }

    localStorage.clear();
</script>
</html>