<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <header>
        <div>
            <h3 id="website_name">VELNORA</h3>
            <div id="btns">
                <a href="/login"><span id="main_login_btn"><button>Login</button></a>
                <a href="/signin"><span id="main_signin_btn"><button>Signin</button></a> 
            </div>
        </div>
    </header>
    <div id="products">
        <%  Products.forEach((product,index) => { %>
            <div class="product-card" data-id="<%= product._id %>">
                <img src="<%= product.image %>" alt="<% product.description %>"/>
                <h2><%= product.name %></h2>
                <a href="/prod/<%= product._id %>"><button>View details</button></a>
            </div>
        <% }) %> 
    </div>
    <button id="load_btn" type="button">Load more products...</button>
</body>
</html>