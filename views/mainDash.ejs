<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header>
        <div>
            <h3 id="website_name">VELNORA</h3>
            <div id="btns">
                <a href="/login"><span id="main_login_btn"><button>Login</button></a>
                <a href="/signin"><span id="main_signin_btn"><button>Signin</button></a> 
            </div>
        </div>
    </header>
    <div id="products">
        <%  Products.forEach((product,index) => { %>
            <div class="product-card" data-id="<%= product._id %>">
                <img src="<%= product.image %>" alt="<% product.description %>"/>
                <h2><%= product.name %></h2>
                <button class="dash_cart" type="button">Add To Cart</button>
                <a href="/prod/<%= product._id %>"><button class="view">View details</button></a>
            </div>
        <% }) %> 
    </div>
</body>
<script>
    let productList = document.getElementById("products");
    productList.addEventListener("click",(event)=>{
        if(event.target.closest('.dash_cart')){
            Swal.fire({
                icon: "error",
                title: "Oops...",
                text: "Signup to add in your cart",
                footer: "Already have an account? <a href='/login'>Login</a>"
            });
        }
    })
</script>
</html>