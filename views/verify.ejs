<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css""/>
</head>
<body>
    <form id="verify_form" method="POST" action="/verify/<%= email %>/<%= token %>">
        <input id="verify_name" type="text" name="name" placeholder="name"/>
        <input id="verify_pass" type="password" name="password" placeholder="password"/>
        <button id="verify_submit" type="submit">Submit</button>
    </form>
</body>
</html>