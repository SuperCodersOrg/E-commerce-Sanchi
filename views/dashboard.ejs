<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <header>
        <div>
            <h3 id="website_name">VELNORA</h3>
            <span id="user_img"><img src="/logo.png"/></span>
            <div id="user_name">
                <% if(name) { %>
                    <span><%= name %></span>
                <% } %>
            </div>
        </div>
        <%- include('./partials/header') %>
    </header>
    <div id="products">
        <%  Products.forEach((product,index) => { %>
            <div class="product-card" data-id="<%= product.id %>">
                <img src="<%= product.image %>" alt="<% product.description %>"/>
                <h2><%= product.name %></h2>
                <a href="/prod/<%= product._id %>"><button>View details</button></a>
            </div>
        <% }) %> 
    </div>
    <button id="load_btn" type="button">Load more products...</button>
</body>
<script>
    let load_btn = document.getElementById('load_btn');
    let productDiv = document.getElementById("products");
    load_btn.addEventListener("click",async ()=>{
        let product_cards = document.querySelectorAll('.product-card');
        
        if(!product_cards){
            return res.status(401).send('No product can be found');
        }

        console.log(product_cards);

        let lastCard =  product_cards[product_cards.length-1] ;
        let id = lastCard.dataset.id;
        console.log(id);

        const result = await fetch(`/fetch`,{
            method : 'POST',
            headers : {
                'Content-Type' : 'application/json',
            },
            body : JSON.stringify({ _id : id })
        });

        if(!result.ok){
            return;
        }
            
        let html = await result.text();
            
        if(!html.trim()){
            load_btn.hidden = true;
            return;
        }

        productDiv.insertAdjacentHTML('beforeend',html);
    });
</script>
</html>