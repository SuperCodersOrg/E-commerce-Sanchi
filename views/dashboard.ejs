<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <header>
        <div>
            <h3 id="website_name">VELNORA</h3>
            <span id="user_img"><img src="/logo.png"/></span>
            <div id="user_name">
                <% if(name) { %>
                    <span><%= name %></span>
                <% } %>
            </div>
        </div>
        <%- include('./partials/header') %>
    </header>
    <div id="products">
        <%  Products.forEach((product,index) => { %>
            <!-- <div class="product-card"> -->
            <div class="product-card">
                <img src="<%= product.image %>" alt="<% product.description %>"/>
                <h2><%= product.name %></h2>
                <a href="/prod/<%= product._id %>"><button>View details</button></a>
            </div>
        <% }) %> 
        <!-- <%- include('./partials/after_prod') %>    -->
    </div>
    <button id="load_btn" type="button">Load more products...</button>
</body>
<script>
    // let product_cards = document.querySelectorAll('.product-card');
    let load_btn = document.getElementById('load_btn');
    let productDiv = document.getElementById("products");
    // let count = 4;
    load_btn.addEventListener("click",()=>{
        let id = "<%= Products[Products.length-1]._id %>";
        console.log(id);
        fetch(`http://localhost:<%= process.env.PORT %>/fetch`,{
            method : 'POST',
            headers : {
                'Content-Type' : 'application/json',
            },
            body : JSON.stringify({ '_id' : id })
        }).then((result)=>{
            return result.text();
        }).then((html)=>{
            productDiv.insertAdjacentHTML('beforeend',html);
        })
        // let nextCount = count + 4;
        // for(let i=count ; i<nextCount ; i++){
        //     product_cards[i].hidden = false;
        // }
        // count = nextCount;
        // if(count >= product_cards.length ){
        //     load_btn.hidden = true;
        // }
    });
</script>
</html>