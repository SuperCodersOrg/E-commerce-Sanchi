<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body class="order-page">
    <div class="place-order-container">
        <h1>Shipping Details</h1>
        <form class="place-order-form" id="orderForm" method="POST" action="/bill">
        <label for="order_name">Name</label>
        <input type="text" placeholder="Your name" name="order_name" id="order_name">

        <label for="order_phone">Phone No.</label>
        <input type="tel" pattern="[0-9]{10}" placeholder="Your number" name="order_phone" id="order_phone">

        <label for="address">Address</label>
        <input type="text" name="address" placeholder="Your address" id="address">

        <label for="pincode">Pincode</label>
        <input type="number" name="pincode" id="pincode" placeholder="Pincode">

        <label for="city">City</label>
        <input type="text" name="city" placeholder="Your city" id="city">

        <label for="state">State</label>
        <input type="text" name="state" id="state" placeholder="Your state">

        <button type="submit" class="order-primary-btn" id="submitOrder">Generate Bill</button>
    </form>
    </div>
</body>
</html>