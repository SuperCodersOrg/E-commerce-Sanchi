<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <lin rel="stylesheet" href="/style.css"/>
</head>
<body>
    <header>
        <div>
            <h3 id="website_name">VELNORA</h3>
            <span id="user_img"><img src="/logo.png"/></span>
            <div id="user_name">
                <% if(name) { %>
                    <span><%= name %></span>
                <% } %>
            </div>
            <a href="/cart-page"><button type="button" id="cart" style="cursor: pointer; background-color: #fffcf7; border: none; color: #5c493a; margin: 5px 0px;"></button>
        </div>
    </header>
</body>
<script>
    let cart_icon = `<svg xmlns="http://www.w3.org/2000/svg" width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-bag preview-icon"><path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/></svg>`;
    let cart = document.getElementById("cart");
    cart.innerHTML=`${cart_icon}`;
</script>
</html>
