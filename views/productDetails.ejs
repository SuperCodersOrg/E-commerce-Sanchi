<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <% if(product) { %>
        <main class="product_details">
            <div id="product_details_left">
                <img src="<%= product.image %>" alt="<%= product.description %>"/>
                <h2><%= product.name %></h3>
                <h3><%= product.title %></h2>
            </div>
            <div id="product_details_right">
                <div id="product_breadcrumb"> VELNORA / <%= product.category %> </div>
                <h2><%= product.name %></h2>
                <div id="price">$<%= product.price %></div> 
                <div id="select_size">Select Size</div>
                <div id="product_sizes">
                    <% product.size.forEach((size)=>{ %>
                        <span class="size"><%= size %></span>
                    <% }) %>
                </div>
                <button class="add_to_cart" data-id="<%= product._id %>">Add To Cart</button>
                <div id="brand">Brand: <%= product.brand %></div>   
            </div>
        </main>
    <% } %>
</body>
<script>
    let cartButton = document.querySelector('.add_to_cart');
    cartButton.addEventListener("click",(event)=>{
        let cardId = event.target.dataset.id;
        console.log(cardId);
        fetch('/add-to-cart',{
            method : 'POST',
            headers : {
                'Content-Type' : 'application/json'
            },
            body : JSON.stringify({ _id : cardId })
        });
        let particular_cart = event.target.closest('.add_to_cart');
        particular_cart.disabled = true;
    });
</script>
</html>