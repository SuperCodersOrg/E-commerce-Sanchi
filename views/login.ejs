<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <h1 id="login_head">Login page</h1>
    <form id="login_form" method="post" action="/login">
        <input id="log_name" type="text" name="name" placeholder="name"/>
        <input id="log_email" type="email" name="email" placeholder="email"/>
        <input id="log_pass" type="password" name="password" placeholder="password"/>
        <a href="/forget-password"><button id="forget-button" type="button">Forget Password??</button></a>
        <a href="/dashboard/:name"><button id="log_submit" type="submit">Submit</button></a>
    </form><br/>
</body>
</html>